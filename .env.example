# Copy to .env (ignored by Git) and fill from your password manager. Never commit real values.
HEVY_API_KEY=
# Same value as HEVY_INSIGHTS_DB_PASSWORD in platform-infra/.env
HEVY_INSIGHTS_DB_PASSWORD=
# Optional: UUID of the single user. Leave the line commented to use the default in application.yaml;
# an empty value would stop the app at startup.
# HEVY_INSIGHTS_USER_ID=
